    "services": {
        "prune_docker": {
            "name": "Prune Docker resources",
            "description": "Removes unused Docker resources on the selected Komodo servers. Deleted data cannot be recovered.",
            "fields": {
                "server": {
                    "name": "Servers",
                    "description": "The Komodo servers to prune."
                },
                "prune_type": {
                    "name": "Prune type",
                    "description": "What to remove. 'Unused volumes' deletes every volume not attached to a container. 'Full system' also removes stopped containers first, so their volumes are deleted as well."
                }
            }
        },
        "restart_all_containers": {
            "name": "Restart all containers",
            "description": "Restarts all containers on the selected Komodo servers.",
            "fields": {
                "server": {
                    "name": "Servers",
                    "description": "The Komodo servers whose containers to restart."
                }
            }
        },
        "global_auto_update": {
            "name": "Global auto update",
            "description": "Checks all stacks and deployments with update polling enabled for new images, and redeploys those with auto update enabled. Requires an admin API key.",
            "fields": {
                "config_entry_id": {
                    "name": "Komodo instance",
                    "description": "The Komodo instance to run the update check on."
                },
                "skip_auto_update": {
                    "name": "Skip auto update",
                    "description": "Only check for updates, do not redeploy resources that have auto update enabled."
                }
            }
        }
    },
